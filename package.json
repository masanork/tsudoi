{
  "name": "tsudoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc --noEmit",
    "typecheck": "tsc --noEmit && npm --prefix web run check",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "stats": "node scripts/health.mjs",
    "stats:save": "node scripts/health.mjs --save",
    "db:migrate:local": "wrangler d1 migrations apply tsudoi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tsudoi-db --remote",
    "types": "wrangler types ./src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "hono": "^4.7.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
