{
  "name": "tsudoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:staging": "npm run build:web && wrangler dev --env staging",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && node scripts/wrangler-env.mjs staging deploy",
    "deploy:production": "npm run build && node scripts/wrangler-env.mjs production deploy",
    "typecheck": "tsc --noEmit && npm --prefix web run check",
    "test": "vitest run --passWithNoTests",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:operations": "node --test test/scripts/production-preflight.test.mjs",
    "check:deployed": "node scripts/production-preflight.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "stats": "node scripts/health.mjs",
    "stats:save": "node scripts/health.mjs --save",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "node scripts/wrangler-env.mjs staging d1 migrations apply DB --remote",
    "db:migrate:production": "node scripts/wrangler-env.mjs production d1 migrations apply DB --remote",
    "types": "wrangler types ./src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.17",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
