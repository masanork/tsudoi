{
  "name": "tsudoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:staging": "npm run build:web && wrangler dev --env staging",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "typecheck": "tsc --noEmit && npm --prefix web run check",
    "test": "vitest run --passWithNoTests",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "stats": "node scripts/health.mjs",
    "stats:save": "node scripts/health.mjs --save",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "types": "wrangler types ./src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.1.1",
    "hono": "^4.7.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
